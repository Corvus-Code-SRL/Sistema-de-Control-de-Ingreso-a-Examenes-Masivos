# Variables para Compose. Copiar a deployment/docker/.env y mantener fuera de Git.
IMAGE_TAG=local
PHP_TAG=8.0.30-apache-bullseye
NODE_TAG=22.23.2-bookworm-slim
COMPOSER_TAG=2.9
POSTGRES_TAG=15.0
POSTGRES_IMAGE=postgres:15.0
REDIS_IMAGE=redis:7.4.3
WEB_PORT=18080
WEB_BIND_IP=127.0.0.1
VITE_API_URL=http://localhost:18080/api
POSTGRES_DB=sciem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REEMPLAZAR_CLAVE_ADMIN_DB

# Variables de Laravel (web y scheduler).
APP_NAME=SCIEM
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:18080
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sciem
DB_USERNAME=sciem_app
DB_PASSWORD='REEMPLAZAR_CLAVE_APP_DB'
DB_SCHEMA=public
DB_SSLMODE=prefer

CACHE_DRIVER=redis
ENTRY_CONTROL_CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DRIVER=local
BROADCAST_DRIVER=log

SCIEM_USUARIO_PRUEBA=00000000-0000-4000-8000-000000000001
SCIEM_CUENTAS_SISTEMA=000000000
SCIEM_ZONA_HORARIA=America/La_Paz
SCIEM_NOMINA_MAX_FILAS=2000
SCIEM_RATE_API=180
SCIEM_RATE_POLLING=90
SCIEM_RATE_GUEST=60
SCIEM_RATE_LOGIN_ACCOUNT=10
SCIEM_RATE_LOGIN_IP=300
SCIEM_EVIDENCIA_DISCOS=local,public
# Proxy inverso delante de Apache (ver PRODUCCION.md, «Red, proxy y límites»). Vacío = acceso directo.
# '*' solo si Apache queda publicado en 127.0.0.1 (WEB_BIND_IP) detrás de un proxy en el mismo servidor.
SCIEM_PROXIES_CONFIABLES=

SCIEM_PG_DUMP=/usr/local/bin/pg_dump
SCIEM_PG_RESTORE=/usr/local/bin/pg_restore
SCIEM_RESPALDO_DIRECTORIO=/respaldos
SCIEM_RESPALDO_RETENCION=7
SCIEM_RESPALDO_DIARIO=true
SCIEM_RESPALDO_HORA=03:15
SCIEM_RESPALDO_TIMEOUT=1800
SCIEM_RESTAURAR_PERMITIDO=false

# Solo para simulación; configurar SMTP real si se necesita enviar correo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=soporte@example.invalid
MAIL_FROM_NAME=SCIEM

# Solo para el primer despliegue. El alta se omite si ya existe un administrador humano.
BOOTSTRAP_ADMIN_CODE=REEMPLAZAR_CODIGO_ADMIN
BOOTSTRAP_ADMIN_NAME=REEMPLAZAR_NOMBRE
BOOTSTRAP_ADMIN_LAST_NAME=REEMPLAZAR_APELLIDO
BOOTSTRAP_ADMIN_MATERNAL_LAST_NAME=
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CLAVE_TEMPORAL
