APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# false por defecto: con true las respuestas de error incluyen trazas y rutas del servidor.
# El .env local de cada desarrollador puede usar true.
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos de desarrollo compartida (Supabase, Session Pooler). Los valores
# reales se piden al equipo; nunca se escriben en un archivo versionado.
#   * DB_PORT es 5432 (Session Pooler). Nunca 6543 (Transaction Pooler).
#   * DB_USERNAME lleva un punto antes del id del proyecto: postgres.<id-proyecto>
#   * Supabase exige TLS: usar DB_SSLMODE=require.
# Para una base local usar DB_HOST=127.0.0.1, DB_USERNAME=postgres y DB_SSLMODE=prefer.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<id-proyecto>
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require

# Los valores siguientes apuntan a los datos de prueba compartidos
# (database/seeders/TestData, ver README). Son temporales.
# El periodo vigente no se configura aqui: es la fila de gestion_periodo con vigente = true
# (la lee SubjectCatalogService::activePeriodId(); ver docs/database/periodo-vigente.md).
# SCIEM_PERIODO_ACTIVO_ID ya no se usa: solo lo leia la migracion ...000001 al migrar una base antigua.
# Cuenta de sistema que firma la bitacora en seeders y comandos (no es un usuario de la API). La siembra UserSeeder.
# Datos de prueba: Valeria Montano Rios (Administrador).
SCIEM_USUARIO_PRUEBA=00000000-0000-4000-8000-000000000001
# Hora local de los examenes (fecha y hora_inicio se guardan sin zona).
SCIEM_ZONA_HORARIA=America/La_Paz
# Maximo de filas de datos por archivo de nomina (CSV o XLSX), sin el encabezado.
SCIEM_NOMINA_MAX_FILAS=2000
# Limites de peticiones por minuto (RNF-03). Con sesion se cuentan por usuario, no por IP.
# Acciones y consultas de un usuario autenticado.
SCIEM_RATE_API=180
# Consultas periodicas: GET .../estado (control de ingreso) y GET .../en-curso. Cuota aparte de la anterior.
SCIEM_RATE_POLLING=90
# Peticiones sin sesion que pasan por el limiter api, por IP.
SCIEM_RATE_GUEST=60
# Login: intentos sobre un mismo codigo SIS desde una misma IP.
SCIEM_RATE_LOGIN_ACCOUNT=10
# Login: intentos desde una IP, sea cual sea el codigo (detras de un NAT, todo el campus comparte IP).
SCIEM_RATE_LOGIN_IP=300

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

ENTRY_CONTROL_CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
