APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos de desarrollo compartida (Supabase, Session Pooler). Los valores
# reales se piden al equipo; nunca se escriben en un archivo versionado.
#   * DB_PORT es 5432 (Session Pooler). Nunca 6543 (Transaction Pooler).
#   * DB_USERNAME lleva un punto antes del id del proyecto: postgres.<id-proyecto>
#   * Supabase exige TLS: usar DB_SSLMODE=require.
# Para una base local usar DB_HOST=127.0.0.1, DB_USERNAME=postgres y DB_SSLMODE=prefer.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<id-proyecto>
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require

# Los tres valores siguientes apuntan a los datos de prueba compartidos
# (database/seeders/TestData, ver README). Son temporales.
# Docente fijo mientras no exista autenticacion. Es public.usuario.id_usuario (uuid).
# Datos de prueba: Marcelo Quiroga Andrade (Docente).
SCIEM_DOCENTE_FIJO_ID=00000000-0000-4000-8000-000000000011
# La tabla periodo no marca cual esta vigente: el periodo activo se define aqui.
# Datos de prueba: periodo 2-2026.
SCIEM_PERIODO_ACTIVO_ID=9303
# Autor de la bitacora mientras no exista sesion real. Lo siembra UserSeeder.
# Datos de prueba: Valeria Montano Rios (Administrador).
SCIEM_USUARIO_PRUEBA=00000000-0000-4000-8000-000000000001
# Hora local de los examenes (fecha y hora_inicio se guardan sin zona).
SCIEM_ZONA_HORARIA=America/La_Paz

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
