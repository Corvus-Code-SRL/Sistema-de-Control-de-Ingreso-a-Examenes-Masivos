# Copiar a .env.testing (no versionado). SIEMPRE una base LOCAL: php artisan test
# borra y recrea el esquema completo de la base indicada en DB_DATABASE.
# NUNCA apuntar este archivo a Supabase ni a ninguna base compartida.
APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sciem_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer
